# URL base de la API. Copia este archivo como .env.local y ajusta según tu entorno.
# Simulador iOS:   http://localhost:8000
# Emulador Android: http://10.0.2.2:8000
# Dispositivo físico: http://<IP-local>:8000
# Producción (EAS): configurar en eas.json > env o en el dashboard de EAS
EXPO_PUBLIC_API_URL=http://localhost:8000
