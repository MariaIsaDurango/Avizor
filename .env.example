APP_ENV=development
CONTRACT_VERSION=1.0.0

POSTGRES_USER=avizor
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=avizor

# ES: Cambiar a 5433 si ya tienes PostgreSQL instalado en tu ordenador.
# EN: Change to 5433 if you already have PostgreSQL installed locally.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://avizor:cambiar_esto@localhost:5432/avizor

JWT_SECRET=generar_con_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=60
PHONE_HMAC_KEY=generar_con_openssl_rand_hex_32
# ES: log = solo escribe el push en el log; expo = lo envía de verdad.
# EN: log = only writes the push to the log; expo = really sends it.
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# ES: log = el código sale en la terminal; smtp = Gmail (local);
#     brevo = API HTTPS de Brevo (Railway, que bloquea el SMTP).
# EN: log = the code shows in the terminal; smtp = Gmail (local);
#     brevo = Brevo HTTPS API (Railway, which blocks SMTP).
MAIL_PROVIDER=log
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=avizorapp1.0@gmail.com
# ES: Contraseña de aplicación de Gmail (16 letras). Nunca subirla a GitHub.
# EN: Gmail app password (16 letters). Never push it to GitHub.
MAIL_PASSWORD=
MAIL_FROM=avizorapp1.0@gmail.com
# ES: Solo con MAIL_PROVIDER=brevo (Railway). EN: Only with MAIL_PROVIDER=brevo (Railway).
BREVO_API_KEY=
# ES: Donde se abre el enlace de cambio de contraseña. EN: Where the password reset link opens.
FRONTEND_URL=http://localhost:8000

CHROMA_PATH=./rag/chroma_db
EMBEDDING_MODEL=intfloat/multilingual-e5-base


# Issue #42 — local snapshot; external calls disabled by default.
AVIZOR_PHISHTANK_LOCAL=1
AVIZOR_VT_KEY=
AVIZOR_GSB_KEY=
AVIZOR_NUMVERIFY_KEY=
AVIZOR_EXTERNAL_URLS=0
# Issue #168: also enables OpenSpam (community spam numbers). Sends the number
# to a third party: keep 0 until the privacy review. Free key = non-commercial.
AVIZOR_EXTERNAL_PHONES=0
AVIZOR_OPENSPAM_KEY=
AVIZOR_PHONE_BUDGET_MS=600
# Issue #193: spaCy model that masks person names in PDF/image text (local).
# es_core_news_md (default, ~350 MB RAM) | es_core_news_sm (less RAM) | empty = off.
AVIZOR_NER_MODEL=es_core_news_md
# JSON list of exact, QA-reviewed public URLs (no query/fragment).
# Empty list prevents all external URL/domain lookup from the backend.
AVIZOR_REPUTATION_PUBLIC_URLS=[]

# Issue #43/#143: RAG enrichment for manual analysis (Groq + ChromaDB corpus).
# Needs an image built with INSTALL_RAG=true, GROQ_API_KEY and CHROMA_PATH.
AVIZOR_RAG_ENABLED=false

# Issue #38: AI text classifier. "keywords" = rules (default); "ml" = ONNX model.
# ML_MODEL_DIR: folder with avizor_classifier.json, model.int8.onnx and tokenizer.json
# (locally: ml/models/avizor-3c-onnx). Empty threshold = the bundle's value.
CLASSIFIER_PROVIDER=keywords
ML_MODEL_DIR=
ML_FRAUD_THRESHOLD=

# Issue #143: provider Groq (do not commit real credentials)
GROQ_API_KEY=
# Model id in the Groq API (the "openai/" prefix is part of Groq's name; it does
# not call OpenAI).
GROQ_MODEL=openai/gpt-oss-20b
# Folder with chroma.sqlite3 (Railway: the mounted volume). Empty = rag default.
# CHROMA_PATH=
