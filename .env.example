APP_ENV=development
CONTRACT_VERSION=1.0.0

POSTGRES_USER=avizor
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=avizor

# ES: Cambiar a 5433 si ya tienes PostgreSQL instalado en tu ordenador.
# EN: Change to 5433 if you already have PostgreSQL installed locally.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://avizor:cambiar_esto@localhost:5432/avizor

JWT_SECRET=generar_con_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=60
PHONE_HMAC_KEY=generar_con_openssl_rand_hex_32

CHROMA_PATH=./rag/chroma_db
EMBEDDING_MODEL=intfloat/multilingual-e5-base
