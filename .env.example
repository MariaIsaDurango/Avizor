APP_ENV=development
CONTRACT_VERSION=1.0.0

POSTGRES_USER=avizor
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=avizor

# ES: Cambiar a 5433 si ya tienes PostgreSQL instalado en tu ordenador.
# EN: Change to 5433 if you already have PostgreSQL installed locally.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://avizor:cambiar_esto@localhost:5432/avizor

JWT_SECRET=generar_con_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=60
PHONE_HMAC_KEY=generar_con_openssl_rand_hex_32
# ES: log = solo escribe el push en el log; expo = lo envía de verdad.
# EN: log = only writes the push to the log; expo = really sends it.
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# ES: log = el código sale en la terminal; smtp = se envía el correo de verdad.
# EN: log = the code shows in the terminal; smtp = the email is really sent.
MAIL_PROVIDER=log
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=avizorapp1.0@gmail.com
# ES: Contraseña de aplicación de Gmail (16 letras). Nunca subirla a GitHub.
# EN: Gmail app password (16 letters). Never push it to GitHub.
MAIL_PASSWORD=
MAIL_FROM=avizorapp1.0@gmail.com
# ES: Donde se abre el enlace de cambio de contraseña. EN: Where the password reset link opens.
FRONTEND_URL=http://localhost:8000

CHROMA_PATH=./rag/chroma_db
EMBEDDING_MODEL=intfloat/multilingual-e5-base


# Issue #42 — local snapshot; external calls disabled by default.
AVIZOR_PHISHTANK_LOCAL=1
AVIZOR_VT_KEY=
AVIZOR_GSB_KEY=
AVIZOR_NUMVERIFY_KEY=
AVIZOR_EXTERNAL_URLS=0
AVIZOR_EXTERNAL_PHONES=0
# JSON list of exact, QA-reviewed public URLs (no query/fragment).
# Empty list prevents all external URL/domain lookup from the backend.
AVIZOR_REPUTATION_PUBLIC_URLS=[]

# Issue #43: local RAG enrichment for manual analysis (requires local Ollama + corpus).
AVIZOR_RAG_ENABLED=false
